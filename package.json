{
  "name": "flowrelay",
  "displayName": "Flow Relay",
  "description": "AI Context Handoff for Teams – async context handoff platform",
  "version": "1.8.0",
  "publisher": "flowrelay",
  "license": "AGPL-3.0-or-later",
  "author": "Adriano Sorbello (atrisorb) <https://github.com/atrisorb>",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/flow-relay/flowrelay-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flowrelay.setApiKey",
        "title": "Flow Relay: Set API Key"
      },
      {
        "command": "flowrelay.generateHandoff",
        "title": "Flow Relay: Generate Handoff"
      },
      {
        "command": "flowrelay.generateHandoffFromSource",
        "title": "Flow Relay: Generate Handoff with Filters..."
      },
      {
        "command": "flowrelay.selectProject",
        "title": "Flow Relay: Select Project Context"
      },
      {
        "command": "flowrelay.listHandoffs",
        "title": "Flow Relay: Show Handoffs"
      },
      {
        "command": "flowrelay.listIntegrations",
        "title": "Flow Relay: Show Integrations"
      },
      {
        "command": "flowrelay.listUntrackedResources",
        "title": "Flow Relay: Show Untracked Resources"
      },
      {
        "command": "flowrelay.showLastHandoff",
        "title": "Flow Relay: Show Last Handoff"
      },
      {
        "command": "flowrelay.discordListChannels",
        "title": "Flow Relay: List Discord Channels"
      },
      {
        "command": "flowrelay.discordSendMessage",
        "title": "Flow Relay: Send Discord Message"
      },
      {
        "command": "flowrelay.generateInsight",
        "title": "Flow Relay: Generate Project Insight..."
      },
      {
        "command": "flowrelay.listInsights",
        "title": "Flow Relay: Show Insights"
      },
      {
        "command": "flowrelay.listDigests",
        "title": "Flow Relay: Show Digests"
      },
      {
        "command": "flowrelay.askProject",
        "title": "Flow Relay: Ask This Project"
      },
      {
        "command": "flowrelay.generateReleaseNotes",
        "title": "Flow Relay: Generate Release Notes"
      },
      {
        "command": "flowrelay.generatePlanReview",
        "title": "Flow Relay: Generate Plan Review"
      },
      {
        "command": "flowrelay.showEarnedValue",
        "title": "Flow Relay: Show Earned Value"
      },
      {
        "command": "flowrelay.showRegister",
        "title": "Flow Relay: Show Risk Register"
      },
      {
        "command": "flowrelay.showPortfolio",
        "title": "Flow Relay: Show Portfolio"
      },
      {
        "command": "flowrelay.showForecast",
        "title": "Flow Relay: Show Forecast"
      },
      {
        "command": "flowrelay.createWorkItemFromSelection",
        "title": "Flow Relay: Create Work Item from Selection"
      },
      {
        "command": "flowrelay.planWhatIf",
        "title": "Flow Relay: Ask a What-if Question"
      },
      {
        "command": "flowrelay.applyTemplate",
        "title": "Flow Relay: Add a Template to the Plan"
      },
      {
        "command": "flowrelay.showApprovals",
        "title": "Flow Relay: Show Change Requests"
      },
      {
        "command": "flowrelay.requestChange",
        "title": "Flow Relay: Request a Change to an Item"
      },
      {
        "command": "flowrelay.decideApproval",
        "title": "Flow Relay: Decide a Change Request"
      },
      {
        "command": "flowrelay.resolveSuggestion",
        "title": "Flow Relay: Accept or Dismiss a Suggestion"
      },
      {
        "command": "flowrelay.createRaidEntry",
        "title": "Flow Relay: Add a Register Entry"
      },
      {
        "command": "flowrelay.deleteWorkItem",
        "title": "Flow Relay: Delete a Work Item"
      },
      {
        "command": "flowrelay.listEvents",
        "title": "Flow Relay: Show Events"
      },
      {
        "command": "flowrelay.listMyWork",
        "title": "Flow Relay: Show My Work"
      },
      {
        "command": "flowrelay.startWorkItem",
        "title": "Flow Relay: Start Work Item",
        "icon": "$(play)"
      },
      {
        "command": "flowrelay.updateWorkItemStatus",
        "title": "Flow Relay: Change Work Item Status..."
      },
      {
        "command": "flowrelay.showBranchWorkItem",
        "title": "Flow Relay: Show Current Branch Work Item"
      },
      {
        "command": "flowrelay.refreshSidebar",
        "title": "Flow Relay: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flowrelay",
          "title": "Flow Relay",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "flowrelay": [
        {
          "id": "flowrelay.workspace",
          "name": "Workspace Context"
        },
        {
          "id": "flowrelay.myWork",
          "name": "My Work"
        },
        {
          "id": "flowrelay.handoffs",
          "name": "Handoffs"
        },
        {
          "id": "flowrelay.integrations",
          "name": "Integrations"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "flowrelay.refreshSidebar",
          "when": "view =~ /^flowrelay\\./",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "flowrelay.startWorkItem",
          "when": "view == flowrelay.myWork && viewItem == workItem",
          "group": "inline"
        },
        {
          "command": "flowrelay.updateWorkItemStatus",
          "when": "view == flowrelay.myWork && viewItem == workItem",
          "group": "workItem@1"
        }
      ]
    },
    "configuration": {
      "title": "Flow Relay",
      "properties": {
        "flowrelay.apiBaseUrl": {
          "type": "string",
          "default": "https://www.flowrelay.it",
          "description": "Base URL for the Flow Relay API"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outdir=dist --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch",
    "vscode:prepublish": "npm run build",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}
