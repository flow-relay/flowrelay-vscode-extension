{
  "name": "flowrelay",
  "displayName": "Flow Relay",
  "description": "Context handoffs, project briefs and work tracking across your team's tools.",
  "version": "1.11.0",
  "publisher": "flowrelay",
  "license": "AGPL-3.0-or-later",
  "author": "Adriano Sorbello (atrisorb) <https://github.com/atrisorb>",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/flow-relay/flowrelay-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flowrelay.getStarted",
        "title": "Get Started",
        "category": "Flow Relay",
        "icon": "$(compass)"
      },
      {
        "command": "flowrelay.setApiKey",
        "title": "Flow Relay: Set API Key"
      },
      {
        "command": "flowrelay.generateHandoff",
        "title": "Flow Relay: Generate Handoff"
      },
      {
        "command": "flowrelay.generateHandoffFromSource",
        "title": "Flow Relay: Generate Handoff with Filters..."
      },
      {
        "command": "flowrelay.selectProject",
        "title": "Flow Relay: Choose Project"
      },
      {
        "command": "flowrelay.listHandoffs",
        "title": "Flow Relay: Show Handoffs"
      },
      {
        "command": "flowrelay.listIntegrations",
        "title": "Flow Relay: Show Integrations"
      },
      {
        "command": "flowrelay.listUntrackedResources",
        "title": "Flow Relay: Show Untracked Resources"
      },
      {
        "command": "flowrelay.showLastHandoff",
        "title": "Flow Relay: Show Last Handoff"
      },
      {
        "command": "flowrelay.discordListChannels",
        "title": "Flow Relay: List Discord Channels"
      },
      {
        "command": "flowrelay.discordSendMessage",
        "title": "Flow Relay: Send Discord Message"
      },
      {
        "command": "flowrelay.generateInsight",
        "title": "Flow Relay: Generate Project Insight..."
      },
      {
        "command": "flowrelay.listInsights",
        "title": "Flow Relay: Show Insights"
      },
      {
        "command": "flowrelay.listDigests",
        "title": "Flow Relay: Show Digests"
      },
      {
        "command": "flowrelay.askProject",
        "title": "Flow Relay: Ask This Project"
      },
      {
        "command": "flowrelay.openAskPanel",
        "title": "Flow Relay: Open Ask Panel"
      },
      {
        "command": "flowrelay.enableMcpServer",
        "title": "Flow Relay: Enable MCP Server"
      },
      {
        "command": "flowrelay.disableMcpServer",
        "title": "Flow Relay: Disable MCP Server"
      },
      {
        "command": "flowrelay.generateReleaseNotes",
        "title": "Flow Relay: Generate Release Notes"
      },
      {
        "command": "flowrelay.generatePlanReview",
        "title": "Flow Relay: Generate Plan Review"
      },
      {
        "command": "flowrelay.showEarnedValue",
        "title": "Flow Relay: Show Earned Value"
      },
      {
        "command": "flowrelay.showRegister",
        "title": "Flow Relay: Show Risk Register"
      },
      {
        "command": "flowrelay.showPortfolio",
        "title": "Flow Relay: Show Portfolio"
      },
      {
        "command": "flowrelay.showForecast",
        "title": "Flow Relay: Show Forecast"
      },
      {
        "command": "flowrelay.createWorkItemFromSelection",
        "title": "Flow Relay: Create Work Item from Selection"
      },
      {
        "command": "flowrelay.planWhatIf",
        "title": "Flow Relay: Ask a What-if Question"
      },
      {
        "command": "flowrelay.applyTemplate",
        "title": "Flow Relay: Add a Template to the Plan"
      },
      {
        "command": "flowrelay.showApprovals",
        "title": "Flow Relay: Show Change Requests"
      },
      {
        "command": "flowrelay.requestChange",
        "title": "Flow Relay: Request a Change to an Item"
      },
      {
        "command": "flowrelay.decideApproval",
        "title": "Flow Relay: Decide a Change Request"
      },
      {
        "command": "flowrelay.resolveSuggestion",
        "title": "Flow Relay: Accept or Dismiss a Suggestion"
      },
      {
        "command": "flowrelay.createRaidEntry",
        "title": "Flow Relay: Add a Register Entry"
      },
      {
        "command": "flowrelay.deleteWorkItem",
        "title": "Flow Relay: Delete a Work Item"
      },
      {
        "command": "flowrelay.listEvents",
        "title": "Flow Relay: Show Events"
      },
      {
        "command": "flowrelay.listMyWork",
        "title": "Flow Relay: Show My Work"
      },
      {
        "command": "flowrelay.startWorkItem",
        "title": "Flow Relay: Start Work Item",
        "icon": "$(play)"
      },
      {
        "command": "flowrelay.updateWorkItemStatus",
        "title": "Flow Relay: Change Work Item Status..."
      },
      {
        "command": "flowrelay.showBranchWorkItem",
        "title": "Flow Relay: Show Current Branch Work Item"
      },
      {
        "command": "flowrelay.refreshSidebar",
        "title": "Flow Relay: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flowrelay",
          "title": "Flow Relay",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "flowrelay": [
        {
          "id": "flowrelay.workspace",
          "name": "Workspace"
        },
        {
          "id": "flowrelay.myWork",
          "name": "My Work"
        },
        {
          "id": "flowrelay.handoffs",
          "name": "Handoffs"
        },
        {
          "id": "flowrelay.integrations",
          "name": "Integrations"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "flowrelay.refreshSidebar",
          "when": "view =~ /^flowrelay\\./",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "flowrelay.startWorkItem",
          "when": "view == flowrelay.myWork && viewItem == workItem",
          "group": "inline"
        },
        {
          "command": "flowrelay.updateWorkItemStatus",
          "when": "view == flowrelay.myWork && viewItem == workItem",
          "group": "workItem@1"
        }
      ]
    },
    "configuration": {
      "title": "Flow Relay",
      "properties": {
        "flowrelay.apiBaseUrl": {
          "type": "string",
          "default": "https://www.flowrelay.it",
          "description": "Base URL for the Flow Relay API"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "flowrelay.ask",
        "name": "flowrelay",
        "fullName": "Flow Relay",
        "description": "Ask about your project's activity, handoffs and work",
        "isSticky": true,
        "commands": [
          {
            "name": "quick",
            "description": "Answer from this thread without searching"
          },
          {
            "name": "search",
            "description": "Search the project for the answer"
          },
          {
            "name": "deep",
            "description": "A longer analysis across the project (slower)"
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "flowrelay.mcp",
        "label": "Flow Relay"
      }
    ],
    "viewsWelcome": [
      {
        "view": "flowrelay.workspace",
        "contents": "Connect your Flow Relay account to see your workspaces and the active project here.\n[Set API key](command:flowrelay.setApiKey)\nCreate a key in [Settings > Connections](https://www.flowrelay.it/settings#connections) on flowrelay.it. New here? [Open the getting started guide](command:flowrelay.getStarted).",
        "when": "!flowrelay.hasApiKey"
      },
      {
        "view": "flowrelay.myWork",
        "contents": "Connect your Flow Relay account to see the items assigned to you here.\n[Set API key](command:flowrelay.setApiKey)\nCreate a key in [Settings > Connections](https://www.flowrelay.it/settings#connections) on flowrelay.it. New here? [Open the getting started guide](command:flowrelay.getStarted).",
        "when": "!flowrelay.hasApiKey"
      },
      {
        "view": "flowrelay.handoffs",
        "contents": "Connect your Flow Relay account to see the latest handoffs of your project here.\n[Set API key](command:flowrelay.setApiKey)\nCreate a key in [Settings > Connections](https://www.flowrelay.it/settings#connections) on flowrelay.it. New here? [Open the getting started guide](command:flowrelay.getStarted).",
        "when": "!flowrelay.hasApiKey"
      },
      {
        "view": "flowrelay.integrations",
        "contents": "Connect your Flow Relay account to see the tools your project follows here.\n[Set API key](command:flowrelay.setApiKey)\nCreate a key in [Settings > Connections](https://www.flowrelay.it/settings#connections) on flowrelay.it. New here? [Open the getting started guide](command:flowrelay.getStarted).",
        "when": "!flowrelay.hasApiKey"
      }
    ],
    "walkthroughs": [
      {
        "id": "flowrelay.getStarted",
        "title": "Get started with Flow Relay",
        "description": "Connect your account, pick a project and bring handoffs, Ask and your work into the editor.",
        "steps": [
          {
            "id": "connect",
            "title": "Connect your account",
            "description": "Flow Relay reads the tools your team already uses and writes handoffs you can cite. Create an API key in Settings > Connections on flowrelay.it, then paste it here. It stays in the editor secret storage.\n[Set API key](command:flowrelay.setApiKey)",
            "media": {
              "image": {
                "light": "media/pebble-bot.svg",
                "dark": "media/pebble-bot-dark-theme.svg"
              },
              "altText": "Pip, the Flow Relay drone, waving hello"
            },
            "completionEvents": [
              "onContext:flowrelay.hasApiKey"
            ]
          },
          {
            "id": "project",
            "title": "Choose a project",
            "description": "Every command works on the active project. The status bar shows which one it is.\n[Choose a project](command:flowrelay.selectProject)",
            "media": {
              "image": {
                "light": "media/pebble-bot.svg",
                "dark": "media/pebble-bot-dark-theme.svg"
              },
              "altText": "Pip pointing at the project list"
            },
            "completionEvents": [
              "onContext:flowrelay.hasProject"
            ]
          },
          {
            "id": "handoff",
            "title": "Write your first handoff",
            "description": "A handoff is a cited summary of what changed: decisions, blockers and next steps. It opens next to your code.\n[Generate a handoff](command:flowrelay.generateHandoff)",
            "media": {
              "image": {
                "light": "media/pebble-bot.svg",
                "dark": "media/pebble-bot-dark-theme.svg"
              },
              "altText": "Pip carrying the relay baton"
            },
            "completionEvents": [
              "onCommand:flowrelay.generateHandoff",
              "onCommand:flowrelay.generateHandoffFromSource"
            ]
          },
          {
            "id": "ask",
            "title": "Ask the project",
            "description": "Ask a question in plain words. Every answer cites the events it comes from. Type @flowrelay in the chat, or open the Ask panel.\n[Open the Ask panel](command:flowrelay.openAskPanel)",
            "media": {
              "image": {
                "light": "media/pebble-bot.svg",
                "dark": "media/pebble-bot-dark-theme.svg"
              },
              "altText": "Pip listening to a question"
            },
            "completionEvents": [
              "onCommand:flowrelay.askProject",
              "onCommand:flowrelay.openAskPanel"
            ]
          },
          {
            "id": "work",
            "title": "Pick up your work",
            "description": "My work lists the items assigned to you across projects. Start one from the editor and Flow Relay links your commits to it.\n[Show my work](command:flowrelay.listMyWork)",
            "media": {
              "image": {
                "light": "media/pebble-bot.svg",
                "dark": "media/pebble-bot-dark-theme.svg"
              },
              "altText": "Pip holding a work item"
            },
            "completionEvents": [
              "onCommand:flowrelay.listMyWork",
              "onView:flowrelay.myWork"
            ]
          },
          {
            "id": "assistant",
            "title": "Connect your AI assistant",
            "description": "Offer the hosted Flow Relay MCP server to the assistants in this editor, so they can read handoffs and update the plan too.\n[Enable the MCP server](command:flowrelay.enableMcpServer)",
            "media": {
              "image": {
                "light": "media/pebble-bot.svg",
                "dark": "media/pebble-bot-dark-theme.svg"
              },
              "altText": "Pip handing the baton to an assistant"
            },
            "completionEvents": [
              "onCommand:flowrelay.enableMcpServer"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outdir=dist --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch",
    "vscode:prepublish": "npm run build",
    "package": "npx @vscode/vsce package --no-dependencies",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
